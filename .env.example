# scripts/setup.sh copies this to .env and fills the generated values. Never commit .env.
JENKINS_URL=http://localhost:8080/
JENKINS_ADMIN_PASSWORD=
JENKINS_VIEWER_PASSWORD=
JENKINS_AGENT_SSH_PUBKEY=
GITHUB_WEBHOOK_SECRET=

# Docker Hub username and an access token with Read & Write scope.
DOCKERHUB_USER=
DOCKERHUB_TOKEN=

# Fine-grained GitHub token for Kiyogitpy/jenkins-demo with Commit statuses: read/write
# and Contents, Metadata, Pull requests: read.
GITHUB_USER=Kiyogitpy
GITHUB_TOKEN=

# ngrok authtoken and your free static domain, for example example.ngrok-free.app.
NGROK_AUTHTOKEN=
NGROK_DOMAIN=
